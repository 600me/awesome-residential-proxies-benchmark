[Unit]
Description=X Matrix Tier-1 Scheduler (ET windows / readback verification / pending self-reply)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory="%h/x-matrix-runtime(X矩阵运行器)"
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=America/New_York
ExecStart="/usr/bin/python3" "%h/x-matrix-runtime(X矩阵运行器)/x_matrix_scheduler.py" --runtime-dir "%h/x-matrix-runtime(X矩阵运行器)" daemon --interval-seconds 300 --delay-self-reply-seconds 240
Restart=always
RestartSec=90
TimeoutStopSec=30
StandardOutput=append:%h/x-matrix-runtime(X矩阵运行器)/state/scheduler.log
StandardError=append:%h/x-matrix-runtime(X矩阵运行器)/state/scheduler.err.log

[Install]
WantedBy=default.target
